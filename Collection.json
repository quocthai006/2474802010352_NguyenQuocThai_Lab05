        {
          "name": "POST User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));\r",
                  "\r",
                  "if (pm.response.code === 201) {\r",
                  "  const json = pm.response.json();\r",
                  "  pm.test(\"Có id\", () => pm.expect(json.id).to.be.a(\"number\"));\r",
                  "  pm.collectionVariables.set(\"userId\", json.id);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = pm.iterationData.get(\"email\") || \"test@example.com\";\r",
                  "pm.collectionVariables.set(\"userEmail\", `${Date.now()}_${email}`);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
